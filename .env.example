# Copy this file to .env and edit it. NEVER commit .env.
# Your Exness MT5 login/password are NOT stored here — the bot uses the
# already-logged-in MT5 terminal. Nothing sensitive goes in this file.

# ---------- mode ----------
MODE=demo
# 0 = dashboard only, places no orders. Flip to 1 when you trust it.
AUTO_TRADE=0
# Extra guard: must stay 0 unless you really mean to trade real money.
ALLOW_LIVE=0

# ---------- instruments ----------
# Base names only. The code resolves Exness suffixes (m, .a, ...) for you.
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,XAUUSD
TIMEFRAME=H1

# ---------- risk (fractions of equity) ----------
RISK_PER_TRADE=0.005     # 0.5% per trade
MAX_GOLD_RISK=0.0035     # 0.35% for XAUUSD
MAX_DAILY_LOSS=0.02      # 2% daily loss -> flatten + stop
MAX_OPEN_TRADES=2
MIN_STOP_ATR=1.5
REWARD_RISK=2.0
TRAIL_ATR=2.5
MAX_SPREAD_POINTS=30

# ---------- session (UTC hours) ----------
SESSION_START_UTC=7
SESSION_END_UTC=17
SKIP_FRIDAY_AFTER_UTC=18

# ---------- plumbing ----------
LOOP_SECONDS=15
MAGIC=77001
DEVIATION=20
DB_PATH=bot.db
# Full path to terminal64.exe. Leave empty to let the package auto-detect.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---------- optional AI layer (not enabled in v1) ----------
XAI_API_KEY=
